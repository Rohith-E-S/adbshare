# Maintainer: adbshare contributors <noreply@example.com>
pkgname=adbshare
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, reliable Linux file manager for Android devices over ADB"
arch=('x86_64' 'aarch64')
url="https://github.com/yourusername/adbshare"
license=('GPL3')
depends=('gtk4' 'libadwaita' 'fuse3' 'libusb')
makedepends=('cargo' 'rust' 'pkgconf')
optdepends=('android-tools: fallback adb binary')

build() {
    cd "$srcdir/.."
    cargo build --release --workspace
}

package() {
    cd "$srcdir/.."
    install -Dm755 target/release/adb-gui "$pkgdir/usr/bin/adb-gui"
    install -Dm755 target/release/adb-daemon "$pkgdir/usr/bin/adb-daemon"
    install -Dm755 target/release/adbshare-proxy "$pkgdir/usr/lib/adbshare/adbshare-proxy"
    install -Dm644 packaging/org.adbshare.Gui.desktop \
        "$pkgdir/usr/share/applications/org.adbshare.Gui.desktop"
    install -Dm644 assets/org.adbshare.Gui.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.adbshare.Gui.svg"
    install -Dm644 packaging/dbus/org.adbshare.Manager.service \
        "$pkgdir/usr/share/dbus-1/services/org.adbshare.Manager.service"
    install -Dm644 packaging/systemd/adbshare-daemon.service \
        "$pkgdir/usr/lib/systemd/user/adbshare-daemon.service"
}
